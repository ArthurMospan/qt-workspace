rules_version = '2';

// ─────────────────────────────────────────────────────────────────────────
// QuickTeam Firestore rules
//
// Multi-tenant model: every org-scoped collection is guarded by membership
// in `orgMemberships/{orgId}_{uid}` (role: owner|admin|member|client). That
// collection is the single source of truth for roles — see CLAUDE.md.
//
// Field-name note: `orgMemberships` docs use `orgId`; every other org-scoped
// collection (projects, issues, tasks, sprints, timeLogs, issueLinks,
// invitations) uses `organizationId`. This is intentional (confirmed by
// code audit), not a bug — don't "fix" it by renaming one of them without
// updating every hook that reads it.
//
// Membership invitations, project/issue creation and deletion, API keys,
// profile sharing, and notification delivery go through authenticated server
// routes. Client rules intentionally deny those privileged write/read paths.
// ─────────────────────────────────────────────────────────────────────────

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ────────────────────────────────────────────────────────
    function signedIn() {
      return request.auth != null;
    }

    function membershipDoc(orgId) {
      return get(/databases/$(database)/documents/orgMemberships/$(orgId + '_' + request.auth.uid));
    }

    function isOrgMember(orgId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/orgMemberships/$(orgId + '_' + request.auth.uid));
    }

    function orgRole(orgId) {
      return membershipDoc(orgId).data.role;
    }

    function isOrgAdminOrOwner(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) in ['owner', 'admin'];
    }

    function isOrgOwner(orgId) {
      return isOrgMember(orgId) && orgRole(orgId) == 'owner';
    }

    function userIsOrgMember(orgId, uid) {
      return exists(/databases/$(database)/documents/orgMemberships/$(orgId + '_' + uid));
    }

    function projectOrg(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data.organizationId;
    }

    function issueOrg(issueId) {
      return get(/databases/$(database)/documents/issues/$(issueId)).data.organizationId;
    }

    function taskOrg(taskId) {
      return get(/databases/$(database)/documents/tasks/$(taskId)).data.organizationId;
    }

    // ── organizations/{orgId} ──────────────────────────────────────────
    match /organizations/{orgId} {
      allow read: if signedIn() && (isOrgMember(orgId) || resource.data.ownerId == request.auth.uid);
      allow create: if signedIn() && request.resource.data.ownerId == request.auth.uid &&
        !request.resource.data.keys().hasAny(['apiKeys']);
      allow update: if isOrgAdminOrOwner(orgId) &&
        request.resource.data.ownerId == resource.data.ownerId &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['apiKeys']);
      allow delete: if false; // Requires a future server-side cascading delete.

      match /presence/{uid} {
        allow read: if isOrgMember(orgId);
        allow create, update: if isOrgMember(orgId) && request.auth.uid == uid;
        allow delete: if false;
      }
    }

    // ── orgMemberships/{orgId}_{uid} — RBAC source of truth ────────────
    match /orgMemberships/{membershipId} {
      allow read: if signedIn() &&
        (resource.data.userId == request.auth.uid || isOrgMember(resource.data.orgId));

      allow create: if signedIn() &&
        request.resource.data.id == membershipId &&
        membershipId == request.resource.data.orgId + '_' + request.resource.data.userId && (
        // Bootstrap: first owner of a freshly created org (org doc already
        // carries ownerId == you, written by the same onboarding flow).
        (request.resource.data.userId == request.auth.uid &&
         request.resource.data.role == 'owner' &&
         get(/databases/$(database)/documents/organizations/$(request.resource.data.orgId)).data.ownerId == request.auth.uid)
      );

      allow update: if signedIn() &&
        membershipId == resource.data.orgId + '_' + resource.data.userId &&
        request.resource.data.orgId == resource.data.orgId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['role', 'hourlyRate', 'positionId', 'updatedAt']) && (
        request.resource.data.role in ['owner', 'admin', 'member'] &&
        (request.resource.data.role != 'owner' || resource.data.role == 'owner') &&
        (resource.data.role == 'owner' || request.resource.data.role == 'owner'
          ? isOrgOwner(resource.data.orgId)
          : isOrgAdminOrOwner(resource.data.orgId)) &&
        (resource.data.role != 'owner' || request.resource.data.role == 'owner')
      );

      allow delete: if signedIn() &&
        resource.data.role != 'owner' &&
        (isOrgAdminOrOwner(resource.data.orgId) || request.auth.uid == resource.data.userId);
    }

    // ── users/{uid} — private self profile. Organization-visible profile
    //    fields are returned by /api/organizations/:id/members. ─────────
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid;
      allow delete: if false;

      match /settings/{settingsDoc} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }

      // Written only by the Admin SDK in /api/integrations/qtplus/*. Holds the
      // sealed QuickTeam+ refresh token: readable by nobody, including the
      // account's own owner, who has no use for it. Default-deny already covers
      // this — stated explicitly so a future wildcard under users/{uid} cannot
      // silently expose a live credential. Mirrors organizations/{orgId}/private.
      match /private/{privateDoc} {
        allow read, write: if false;
      }
    }

    // ── invitations/{id} ────────────────────────────────────────────────
    match /invitations/{id} {
      allow read: if signedIn() &&
        (resource.data.email == request.auth.token.email || isOrgAdminOrOwner(resource.data.organizationId));
      allow create: if false; // Created by the authenticated invitation API.
      allow update: if isOrgAdminOrOwner(resource.data.organizationId);
      allow delete: if isOrgAdminOrOwner(resource.data.organizationId);
    }

    // ── projects/{projectId} — created only via Admin SDK (/api/projects,
    //    which enforces plan limits); client can read/update/delete ──────
    match /projects/{projectId} {
      // Per-project access: owners/admins see everything; a plain member may
      // only read a project they are a `team` member of. `team is list` guards
      // legacy docs written before the field existed (the backfill migration
      // stamps them). Rules are not filters, so the member client query must
      // use `where('team','array-contains', uid)` to match this exactly.
      allow read: if isOrgMember(resource.data.organizationId) && (
        isOrgAdminOrOwner(resource.data.organizationId) ||
        request.auth.uid in resource.data.team
      );
      allow create: if false;
      allow update: if request.resource.data.organizationId == resource.data.organizationId && (
        (isOrgAdminOrOwner(resource.data.organizationId) && request.resource.data.status == resource.data.status) ||
        (isOrgMember(resource.data.organizationId) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'issueCounter']))
      );
      allow delete: if false; // Cascading deletion is handled by /api/projects/[projectId].

      // Portal chat — client + workspace side, scoped via parent project.
      match /messages/{msgId} {
        allow read: if isOrgMember(projectOrg(projectId));
        allow create: if isOrgMember(projectOrg(projectId)) && request.resource.data.senderId == request.auth.uid;
        allow update: if isOrgMember(projectOrg(projectId)) &&
          resource.data.senderId == request.auth.uid &&
          request.resource.data.senderId == resource.data.senderId;
        allow delete: if isOrgMember(projectOrg(projectId)) && resource.data.senderId == request.auth.uid;
      }
    }

    // ── stages/{stageId} — created only via Admin SDK, no organizationId
    //    field (scoped through the parent project) ──────────────────────
    match /stages/{stageId} {
      allow read: if isOrgMember(projectOrg(resource.data.projectId));
      allow create, delete: if false;
      allow update: if isOrgMember(projectOrg(resource.data.projectId)) &&
        request.resource.data.projectId == resource.data.projectId;

      match /materials/{materialId} {
        allow read, write: if isOrgMember(projectOrg(get(/databases/$(database)/documents/stages/$(stageId)).data.projectId));
      }
    }

    // ── issues/{issueId} ─────────────────────────────────────────────────
    match /issues/{issueId} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow create: if false; // Created through /api/issues or trusted integrations.
      allow update: if isOrgMember(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        !request.resource.data.diff(resource.data).affectedKeys()
          .hasAny(['organizationId', 'projectId', 'issueKey', 'createdAt', 'createdBy']);
      allow delete: if isOrgAdminOrOwner(resource.data.organizationId);

      match /comments/{commentId} {
        allow read: if isOrgMember(issueOrg(issueId));
        allow create: if isOrgMember(issueOrg(issueId)) && request.resource.data.authorId == request.auth.uid;
        // The author may edit their own comment; any org member may mark it read
        // (read receipts) — that write touches only `readBy` and nothing else.
        allow update: if isOrgMember(issueOrg(issueId)) && (
          (resource.data.authorId == request.auth.uid &&
           request.resource.data.authorId == resource.data.authorId) ||
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        );
        allow delete: if isOrgMember(issueOrg(issueId)) &&
          resource.data.authorId == request.auth.uid;
      }

      // Append-only activity log.
      match /audit/{auditId} {
        allow read: if isOrgMember(issueOrg(issueId));
        allow create: if isOrgMember(issueOrg(issueId)) && request.resource.data.userId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // ── issueLinks/{id} ──────────────────────────────────────────────────
    match /issueLinks/{id} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow create: if isOrgMember(request.resource.data.organizationId) &&
        issueOrg(request.resource.data.sourceIssueId) == request.resource.data.organizationId &&
        issueOrg(request.resource.data.targetIssueId) == request.resource.data.organizationId;
      allow delete: if isOrgMember(resource.data.organizationId);
    }

    // ── tasks/{taskId} — legacy/parallel collection to issues ───────────
    match /tasks/{taskId} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow create, update, delete: if false; // Legacy collection; new work uses issues.

      match /taskComments/{commentId} {
        allow read: if isOrgMember(taskOrg(taskId));
        allow create, update, delete: if false;
      }
    }

    // ── sprints/{id} ─────────────────────────────────────────────────────
    match /sprints/{id} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow create: if isOrgAdminOrOwner(request.resource.data.organizationId);
      allow update: if isOrgAdminOrOwner(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isOrgAdminOrOwner(resource.data.organizationId);
    }

    // ── timeLogs/{id} ────────────────────────────────────────────────────
    match /timeLogs/{id} {
      allow read: if isOrgMember(resource.data.organizationId);
      allow create: if isOrgMember(request.resource.data.organizationId) &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isOrgMember(resource.data.organizationId) &&
        (resource.data.userId == request.auth.uid || isOrgAdminOrOwner(resource.data.organizationId)) &&
        request.resource.data.organizationId == resource.data.organizationId &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.issueId == resource.data.issueId &&
        request.resource.data.projectId == resource.data.projectId;
      allow delete: if isOrgMember(resource.data.organizationId) &&
        (resource.data.userId == request.auth.uid || isOrgAdminOrOwner(resource.data.organizationId));
    }

    // ── invoices/{id} ────────────────────────────────────────────────────
    match /invoices/{id} {
      allow read: if isOrgOwner(resource.data.organizationId);
      allow create: if isOrgOwner(request.resource.data.organizationId);
      allow update: if isOrgOwner(resource.data.organizationId) &&
        request.resource.data.organizationId == resource.data.organizationId;
      allow delete: if isOrgOwner(resource.data.organizationId);
    }

    // ── notifications/{id} — created by the authenticated server route;
    //    recipients may only read, delete, or toggle `read`. ──────────────
    match /notifications/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow update: if signedIn() && resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow create: if false;
    }

    // ── presence/{uid} ───────────────────────────────────────────────────
    match /presence/{uid} {
      allow read, write: if false;
    }

    // ── organizations/{orgId}/channels/... — chat, scoped via path ──────
    match /organizations/{orgId}/channels/{channelId} {
      allow read: if isOrgMember(orgId);
      allow create: if isOrgAdminOrOwner(orgId) || (
        isOrgMember(orgId) && (
          request.resource.data.type == 'dm' ||
          (channelId == 'general' && request.resource.data.type == 'public')
        )
      );
      allow update: if isOrgAdminOrOwner(orgId) || (
        isOrgMember(orgId) && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            'typing',
            'lastMessageAt',
            'lastMessageText',
            'lastMessageSender',
            'lastMessageSenderId',
            'messageCount'
          ])
      );
      allow delete: if isOrgAdminOrOwner(orgId);

      match /messages/{msgId} {
        allow read: if isOrgMember(orgId);
        allow create: if isOrgMember(orgId) && request.resource.data.senderId == request.auth.uid;
        allow update: if isOrgMember(orgId) &&
          request.resource.data.senderId == resource.data.senderId && (
            resource.data.senderId == request.auth.uid ||
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions', 'replyCount', 'isPinned'])
          );
        allow delete: if isOrgMember(orgId) && resource.data.senderId == request.auth.uid;

        match /replies/{replyId} {
          allow read: if isOrgMember(orgId);
          allow create: if isOrgMember(orgId) && request.resource.data.senderId == request.auth.uid;
          allow update: if isOrgMember(orgId) &&
            resource.data.senderId == request.auth.uid &&
            request.resource.data.senderId == resource.data.senderId;
          allow delete: if isOrgMember(orgId) && resource.data.senderId == request.auth.uid;
        }
      }
    }

    match /organizations/{orgId}/readState/{stateId} {
      allow read, delete: if isOrgMember(orgId) && resource.data.userId == request.auth.uid;
      allow create: if isOrgMember(orgId) &&
        request.resource.data.userId == request.auth.uid &&
        stateId == request.auth.uid + '_' + request.resource.data.channelId;
      allow update: if isOrgMember(orgId) &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.channelId == resource.data.channelId;
    }

    match /organizations/{orgId}/activeDMs/{uid} {
      allow read: if isOrgMember(orgId);
      allow create, update: if isOrgMember(orgId) && userIsOrgMember(orgId, uid) &&
        request.auth.uid in request.resource.data.partners;
      allow delete: if false;
    }

    match /organizations/{orgId}/settings/{settingsDoc} {
      allow read: if isOrgMember(orgId);
      allow write: if isOrgAdminOrOwner(orgId);
    }

    // Secrets are never stored on the member-readable organization document.
    // They are managed by authenticated Admin SDK routes only.
    match /organizations/{orgId}/private/{privateDoc} {
      allow read, write: if false;
    }
  }
}
