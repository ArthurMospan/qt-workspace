rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Глобальне правило: дозволяємо читання та запис усім авторизованим користувачам
    // TODO: Пізніше потрібно буде деталізувати ці правила для безпеки продакшену
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
    
  }
}
